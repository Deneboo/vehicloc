{% extends 'base.html.twig' %}

{% block title %}Ajouter une voiture{% endblock %}

{% block body %}
    <section id="add">
        <a href="index.html">← Retour</a>
        <h1>Ajouter une voiture</h1>  
        {{ form_start(form) }}

            <div class="input">
                {{ form_label(form.name, 'Nom de la voiture') }}
                {{ form_widget(form.name) }}
            </div>

            <div class="input">
                {{ form_label(form.description, 'Description') }}
                {{ form_widget(form.description) }}
            </div>

            <div class="flex-input">
                <div class="input">
                    {{ form_label(form.monthly_price, 'Prix mensuel') }}
                    {{ form_widget(form.monthly_price) }}
                </div>

                <div class="input">
                    {{ form_label(form.daily_price, 'Prix journalier') }}
                    {{ form_widget(form.daily_price) }}
                </div>
            </div>

            <div class="flex-input">
                <div class="input">
                    {{ form_label(form.places, 'Nombre de places') }}
                    {{ form_widget(form.places) }}
                </div>

                <div class="input">
                    {{ form_label(form.motor, 'Boîte de vitesse') }}
                    {{ form_widget(form.motor) }}
                </div>
            </div>

            <button type="submit" class="btn-add">Ajouter</button>

        {{ form_end(form) }}
    </section>
{% endblock %}